# ============================================================
# CloudLab Copilot — 后端环境变量模板（占位符，禁止填入真实凭据）
# 使用方法：复制为 backend/.env 并替换占位符 your-*-here
# ============================================================

# ----- Spring Profile（生产默认 prod，禁止使用 dev 上线）-----
SPRING_PROFILES_ACTIVE=prod

# ----- 服务端口 -----
SERVER_PORT=8080

# ----- 数据库（PostgreSQL）-----
DB_URL=jdbc:postgresql://your-db-host-here:5432/your-db-name-here
DB_USERNAME=your-db-username-here
DB_PASSWORD=your-db-password-here
DB_DRIVER=org.postgresql.Driver

# ----- Flyway 迁移 -----
FLYWAY_ENABLED=true

# ----- Redis（会话/缓存/限流）-----
REDIS_HOST=your-redis-host-here
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password-here

# ----- 华为云通用 -----
HW_REGION=cn-north-4
HW_AK=your-hw-ak-here
HW_SK=your-hw-sk-here

# ----- 华为云 MaaS（大模型推理）-----
MAAS_ENDPOINT=your-maas-endpoint-here
MAAS_API_KEY=your-maas-api-key-here
MAAS_MODEL=your-maas-model-name-here

# ----- 华为云 OBS（可选）-----
OBS_ENDPOINT=your-obs-endpoint-here
OBS_BUCKET=your-obs-bucket-here

# ----- 安全配置 -----
# CORS 白名单来源，逗号分隔（生产必须为具体域名，禁止使用 *）
APP_SECURITY_CORS_ALLOWED_ORIGINS=https://cloudlab.example.edu.cn
APP_SECURITY_CORS_ALLOW_CREDENTIALS=true
APP_SECURITY_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
APP_SECURITY_CORS_ALLOWED_HEADERS=*
APP_SECURITY_CORS_MAX_AGE=3600
# multipart 上传限制
APP_SECURITY_MULTIPART_MAX_FILE_SIZE=50MB
APP_SECURITY_MULTIPART_MAX_REQUEST_SIZE=100MB